{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/blog(.*)",
      "destination": "/#blog",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|courses/|fonts/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
